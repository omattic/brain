{
  "compilerOptions": {
    "lib": ["ESNext"],
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "removeComments": true,
    "sourceMap": true,
    "target": "ES2020",
    "outDir": "lib",
    "baseUrl": ".",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@testevents/*": ["./tests/events/*"],
      "@events/*": ["./tests/events/*"],
      "@controller/*": ["./src/controller/*"],
      "@middlewares/*": ["./src/middlewares/*"],
      "@services/*": ["./src/services/*"],
      "@tmp/*": ["./src/tmp/*"],
      "@types/*": ["src/types/*"],
      "@tests/*": ["tests/*"],
      "@utils/*": ["src/utils/*"],
      "@tools": ["src/tools/index"],
      "@types": ["src/types/index"],
      "@brain-sdk": ["src/brain-sdk/index"]
    },
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules/**/*",
    ".serverless/**/*",
    ".webpack/**/*",
    "_warmup/**/*",
    ".vscode/**/*"
  ],
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}
