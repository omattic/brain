{
  "name": "brain-dashboard",
  "version": "0.1.0",
  "description": "Tenant dashboard for the brain system",
  "main": "src/worker.ts",
  "scripts": {
    "build": "vite build --config frontend/vite.config.ts",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "dev:worker": "wrangler dev",
    "deploy": "vite build --config frontend/vite.config.ts && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "brain-database": "workspace:*",
    "brain-sdk": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.540.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^18.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^1.0.0",
    "wrangler": "^4.13.2"
  }
}
