{
  "name": "brain-support",
  "version": "0.1.0",
  "description": "Slack bot",
  "scripts": {
    "start": "tsx -r tsconfig-paths/register src/app.ts",
    "dev": "tsx watch src/app.ts",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@esbuild-plugins/node-resolve": "^0.2.2",
    "@slack/bolt": "^4.2.1",
    "@slack/types": "^2.14.0",
    "@slack/web-api": "^7.9.1",
    "brain-database": "workspace:*",
    "brain-sdk": "workspace:*",
    "chalk": "^5.4.1",
    "dotenv": "^16.0.3",
    "mime-types": "^3.0.1",
    "node-emoji": "^2.2.0",
    "node-fetch": "^3.3.2",
    "openai": "^4.0.0",
    "tsconfig-paths": "^4.2.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@types/node": "^18.15.0",
    "@vitest/coverage-v8": "^1.0.0",
    "esbuild": "^0.25.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "wrangler": "^4.13.2"
  }
}
