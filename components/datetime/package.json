{
  "name": "brain-datetime",
  "version": "0.1.0",
  "description": "Cloudflare Workers datetime component",
  "scripts": {
    "start": "tsx -r tsconfig-paths/register src/app.ts",
    "dev": "tsx watch src/app.ts",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/client-sqs": "^3.787.0",
    "aws-xray-sdk-core": "^3.10.3",
    "body-parser": "^2.2.0",
    "brain-sdk": "workspace:*",
    "chalk": "^5.4.1",
    "dotenv": "^16.0.3",
    "express": "^5.1.0",
    "mime-types": "^3.0.1",
    "node-fetch": "^3.3.2",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@esbuild-plugins/node-resolve": "^0.2.2",
    "vite-tsconfig-paths": "^5.1.4",
    "serverless-plugin-tracing": "^2.0.0",
    "@serverless/typescript": "^4.11.1",
    "@types/node": "^18.15.0",
    "@vitest/coverage-v8": "^1.0.0",
    "esbuild": "^0.25.2",
    "serverless-domain-manager": "^8.0.0",
    "serverless-esbuild": "^1.55.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "wrangler": "^4.13.2"
  }
}
